amqp_port: 443
engine:
  type: GlobusComputeEngine
  max_retries_on_system_failure: 1
  max_workers_per_node: 8

  job_status_kwargs:
    max_idletime: 3456000

  address:
    type: address_by_interface
    ifname: bond0.2210

  provider:
    type: PBSProProvider
    launcher:
      type: SimpleLauncher
    account: inference_service
    select_options: ngpus=1
    scheduler_options: '#PBS -l filesystems=home:eagle'
    queue: infer-svc
    init_blocks: 1
    max_blocks: 8
    min_blocks: 0
    nodes_per_block: 1
    walltime: 960:00:00
    worker_init: |
      set -euox pipefail

      # These unused variables are parsed by the inference service
      # (qstat_inference_function) to map the running PBS job to a model:
      model_name="dinov3"
      framework="dinoserver"
      cluster="sophia"

      source /eagle/inference_service/misha/dino-server/.venv/bin/activate

      CHECKPOINT="/eagle/inference_service/misha/dino-server/checkpoints/best.ckpt"
      LOG_DIR="/eagle/inference_service/misha/dino-server/logs"
      mkdir -p "$LOG_DIR"

      PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
        dino-server --default-checkpoint "$CHECKPOINT" \
        > "${LOG_DIR}/${HOSTNAME}_$$.log" 2>&1 &
      SERVER_PID=$!

      # Poll until the server we just started has registered and answers /health,
      # or time out. It self-publishes only once its checkpoint is warm.
      python - "$SERVER_PID" <<'PY'
      import sys, time
      import requests
      from dino_server import registry

      pid = int(sys.argv[1])
      deadline = time.time() + 1800  # 30 min: a cold checkpoint load can be slow
      while True:
          rec = next((s for s in registry.discover_servers() if s["pid"] == pid), None)
          if rec is not None:
              try:
                  r = requests.get(f"{rec['url']}/health", timeout=5)
                  if r.ok and r.json().get("status") == "ok":
                      print(f"[worker_init] dino server healthy on port {rec['port']}", flush=True)
                      break
              except requests.RequestException:
                  pass
          if time.time() > deadline:
              raise SystemExit("Timed out waiting for dino server")
          time.sleep(10)
      PY

      # Preserve these echo statements exactly; parsed by inference service
      echo "Model loaded successfully"
      echo "All models started successfully."
